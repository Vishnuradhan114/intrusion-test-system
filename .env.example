# Copy this to .env for LOCAL testing (python-dotenv not required - these
# are just the same variables you will set in Render's dashboard).
#
# Render Dashboard -> your service -> Environment -> Add these one by one.

APP_SECRET_KEY=some-long-random-string
DEMO_MODE=true
BUSINESS_START_HOUR=9
BUSINESS_END_HOUR=18

# Gmail SMTP (see README "Gmail App Password setup")
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your-16-char-app-password
ALERT_TO_EMAIL=youraddress@gmail.com
